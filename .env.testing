# Test-only overrides. tests/testenv first loads .env.dev for local ports,
# then overrides these safety-critical values before Goravel boots.
ENV=testing
ENVIRONMENT=testing
APP_ENV=testing

APP_KEY=0123456789abcdef0123456789abcdef
JWT_SECRET=test-jwt-secret-for-isolated-tests
API_KEY_SECRET=test-api-secret-for-isolated-tests

DB_CONNECTION=postgres
DB_DATABASE=vault_unit_test

REDIS_DB=15

AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Rate limits stay out of the way of suites that log in many times from one
# address; throttle_test.go sets its own limits.
THROTTLE_LOGIN_PER_IP_EMAIL=100000
THROTTLE_LOGIN_PER_IP=100000
THROTTLE_RECOVER_PER_IP_EMAIL=100000
THROTTLE_AUTH_PER_IP=100000
THROTTLE_API_PER_MINUTE=100000
