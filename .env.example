# =============================================================================
# Macro Wallets (WaaS) - Environment Configuration Template
# =============================================================================
# Copy this file to the appropriate env file and fill in your values:
#   cp .env.example .env.dev       (local development)
#   cp .env.example .env.staging   (staging)
#   cp .env.example .env.prod      (production — NEVER commit with real values)

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENV=dev                    # dev | staging | prod
ENVIRONMENT=development    # development | staging | production
PORT=2002                  # API server port (backend)
# Goravel encryption key (AES-256). EXACTLY 32 bytes; the process refuses to boot
# otherwise. It seals secrets stored in the database, so changing it makes them unreadable.
# Generate: go run . --env=.env.dev artisan key:generate    (or: openssl rand -hex 16)
APP_KEY=
# JWT signing secret. Must not be empty (the process refuses to boot); use 32+ characters.
# Generate: go run . --env=.env.dev artisan jwt:secret      (or: openssl rand -base64 48)
JWT_SECRET=

# -----------------------------------------------------------------------------
# Docker-mapped host ports (change if you have conflicts)
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
LOCALSTACK_PORT=4566

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://vault:vault@localhost:5432/vault?sslmode=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis (cache, rate limits, locks, deposit scanner). REDIS_HOST/PORT/PASSWORD/DB is the
# only Redis configuration; there is no REDIS_URL.
REDIS_HOST=localhost
# REDIS_PORT is set above (it is also the host port docker publishes).
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# Blockchain RPC Endpoints
# -----------------------------------------------------------------------------
# Use testnet URLs for development, mainnet for production.
# See docs/RPC_PROVIDERS.md for provider options and free-tier limits.

# Ethereum (Sepolia testnet / Mainnet)
ETH_RPC_URL=https://eth-sepolia.public.blastapi.io

# Polygon (Amoy testnet / Mainnet)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# Solana (Devnet / Mainnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Bitcoin (Testnet / Mainnet)
BTC_RPC_URL=https://blockstream.info/testnet/api

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# HMAC secret for API authentication — generate with: openssl rand -hex 32
API_KEY_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Master encryption key reference (local for dev, KMS ARN for production)
MASTER_KEY_REF=local:dev-master-key

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AMZ_ACCESS_KEY_ID=
AMZ_SECRET_ACCESS_KEY=

# S3 bucket for SAM deployment artifacts (optional, SAM auto-resolves if empty)
S3_BUCKET=

# -----------------------------------------------------------------------------
# SQS Queue URLs (auto-populated by CloudFormation after deployment)
# -----------------------------------------------------------------------------
WEBHOOK_QUEUE_URL=
WITHDRAWAL_QUEUE_URL=

# -----------------------------------------------------------------------------
# Outbound destinations (pkg/egress). A webhook URL must be https to a public
# host; WEBHOOK_ALLOW_HTTP=true also accepts http:// (a dev or test receiver,
# still on a public host). An RPC endpoint may be a private node; RPC_ALLOW_LINK_LOCAL=true
# also accepts link-local and cloud metadata addresses. Both off by default.
# -----------------------------------------------------------------------------
# WEBHOOK_ALLOW_HTTP=false
# WEBHOOK_ALLOWED_PORTS=443,8443   # empty: any port but 22 and 25
# RPC_ALLOW_LINK_LOCAL=false

# An outbound transfer still unsettled this many hours after it was recorded is
# warned about on every tracker pass and counted by GET /health.
WITHDRAWAL_STALE_AFTER_HOURS=6

# Every tracker pass (confirmation_tracker, or the local confirmation loop) warns
# about a scanned chain whose last completed cycle left the checkpoint more than
# DEPOSIT_SCAN_ALERT_LAG_BLOCKS behind the head (0: the chain's catch-up window) or
# ended more than DEPOSIT_SCAN_ALERT_STALE_MINUTES ago, and about pending blocks.
# One chain apart: DEPOSIT_SCAN_ALERT_LAG_BLOCKS_<CHAIN>, DEPOSIT_SCAN_ALERT_STALE_MINUTES_<CHAIN>.
DEPOSIT_SCAN_ALERT_LAG_BLOCKS=0
DEPOSIT_SCAN_ALERT_STALE_MINUTES=10

# Deposit signature sync (the platform deposit_signatures setting wins field by
# field): the chains (e.g. sol) read account by account with getSignaturesForAddress
# instead of block by block; their block scan pauses while they are listed. The
# local workers sync a listed chain only where it is in LOCAL_DEPOSIT_SCAN_CHAINS.
DEPOSIT_SIGNATURE_CHAINS=
DEPOSIT_SIGNATURE_INTERVAL_SECONDS=600   # at least 15
DEPOSIT_SIGNATURE_CONCURRENCY=2          # accounts read at once, 1 to 16
DEPOSIT_SIGNATURE_MAX_PAGES=10           # pages of 1000 signatures per account without a scan checkpoint

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Local uses Mailpit (SMTP on 1025) or MAIL_MAILER=log.
# The log driver is refused when APP_ENV is production.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@vault.dev
MAIL_FROM_NAME=Vault
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
DEBUG=true
GRAPHQL_PLAYGROUND_ENABLED=true

# -----------------------------------------------------------------------------
# Monitoring & Error Reporting
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Webhook Provider Keys (deposit monitoring via push notifications)
# -----------------------------------------------------------------------------
ALCHEMY_AUTH_TOKEN=
HELIUS_API_KEY=
QUICKNODE_API_KEY=
ETHERSCAN_API_KEY=
# Public https origin the providers post to; ingest:subscribe appends
# /v1/webhooks/ingest/{provider}/{chain} (e.g. https://wallets.example.com).
# The ingest_push.base_url platform setting wins when it holds a valid URL.
WEBHOOK_INGEST_BASE_URL=

# -----------------------------------------------------------------------------
# Client IP behind a reverse proxy
# -----------------------------------------------------------------------------
# Comma-separated CIDRs of the proxies whose X-Forwarded-For the API believes.
# The client address is the connection's own address unless that peer is listed
# here; then X-Forwarded-For is read right to left and the first address that is
# not listed is the client. It feeds the API token ip_cidr check and the rate limits.
# nginx on the same host as the API (Forge, with Cloudflare real_ip in front):
#   proxy_set_header X-Forwarded-For $remote_addr;
# and keep the default, which trusts only loopback. Do not list 0.0.0.0/0: that lets
# any caller choose its own address. Behind API Gateway / Lambda the peer is the
# source IP and nothing needs to be trusted.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# -----------------------------------------------------------------------------
# Rate limits (attempts per minute; 0 turns a limit off)
# -----------------------------------------------------------------------------
# Counted in the Cache (Redis) per client IP, see TRUSTED_PROXIES above.
# THROTTLE_LOGIN_PER_IP_EMAIL=10     # POST /v1/auth/login, per IP + email
# THROTTLE_LOGIN_PER_IP=60           # POST /v1/auth/login, per IP
# THROTTLE_RECOVER_PER_IP_EMAIL=5    # POST /v1/auth/recover, per IP + email
# THROTTLE_AUTH_PER_IP=60            # other /v1/auth routes that take a secret, per IP and path
# THROTTLE_API_PER_MINUTE=600        # /api/v1, per API token
