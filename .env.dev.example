# =============================================================================
# Macro Wallets (WaaS) - Development Environment
# =============================================================================
# Copy to .env.dev:  cp .env.dev.example .env.dev
# Free public RPC endpoints are pre-filled for quick local development.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENV=dev
ENVIRONMENT=development
APP_ENV=local
PORT=2002
# Goravel encryption key, exactly 32 bytes (the process refuses to boot otherwise). Leave empty to auto-fill via `make` (artisan key:generate), or run: make key-generate
APP_KEY=
# Invite links. The API reads this and does not substitute a host.
APP_FRONTEND_URL=http://localhost:2001
# JWT signing secret, required (the process refuses to boot when empty). Leave empty then run: go run . --env=.env.dev artisan jwt:secret
JWT_SECRET=

# Login second factor (TOTP). Defaults shown; the challenge lives in Redis.
# AUTH_2FA_CHALLENGE_TTL_SECONDS=300
# AUTH_2FA_MAX_ATTEMPTS=5
# AUTH_2FA_ATTEMPT_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Docker-mapped host ports (change if you have conflicts)
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
LOCALSTACK_PORT=4566

# -----------------------------------------------------------------------------
# Database (PostgreSQL — matches docker-compose defaults)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://vault:vault@localhost:5432/vault?sslmode=disable
# Goravel ORM (must align with DATABASE_URL)
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vault
DB_USERNAME=vault
DB_PASSWORD=vault
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis (cache, rate limits, locks, deposit scanner). REDIS_HOST/PORT/PASSWORD/DB is the
# only Redis configuration; there is no REDIS_URL.
REDIS_HOST=localhost
# REDIS_PORT is set above (it is also the host port docker publishes).
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# Blockchain RPC Endpoints (testnet / devnet — free, no key required)
# -----------------------------------------------------------------------------
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
SOLANA_RPC_URL=https://api.devnet.solana.com
BTC_RPC_URL=https://blockstream.info/testnet/api
# XRP Ledger testnet (altnet). Classic r-addresses are the same on mainnet; these
# URLs are read-only until a payment builder exists. txrp always uses the testnet.
XRP_RPC_URL=https://s.altnet.rippletest.net:51234
TXRP_RPC_URL=https://s.altnet.rippletest.net:51234
# Testnet chains (the t* records the chain seed creates). Each record reads its own
# variable when the seed runs: a missing one leaves that chain without an endpoint.
# Re-run `make db-seed` after changing them; the seed refreshes the stored endpoint.
TETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TPOLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
TSOL_RPC_URL=https://api.devnet.solana.com
TBTC_RPC_URL=https://mempool.space/testnet4/api
TBASE_RPC_URL=https://sepolia.base.org
TARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
TBSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
TTRON_RPC_URL=https://nile.trongrid.io
TLTC_RPC_URL=https://litecoinspace.org/testnet/api

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
API_KEY_SECRET=dev-secret-key-not-for-production
MASTER_KEY_REF=local:dev-master-key

# Dedicated Sepolia EOA used only to fund dynamically-created E2E wallets.
# Generate with: go run ./tools/e2e-funder generate
E2E_FUNDER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# AWS Configuration (leave empty to use LocalStack)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AMZ_ACCESS_KEY_ID=
AMZ_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# SQS Queue URLs (leave empty for local; LocalStack auto-creates if needed)
# -----------------------------------------------------------------------------
WEBHOOK_QUEUE_URL=
WITHDRAWAL_QUEUE_URL=

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Local uses Mailpit (SMTP on 1025, UI on 8025) or MAIL_MAILER=log.
# The log driver is refused when APP_ENV is production.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@vault.dev
MAIL_FROM_NAME=Vault
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
DEBUG=true
GRAPHQL_PLAYGROUND_ENABLED=true

# -----------------------------------------------------------------------------
# Monitoring (optional for local dev)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Client IP behind a reverse proxy
# -----------------------------------------------------------------------------
# Comma-separated CIDRs of the proxies whose X-Forwarded-For the API believes.
# The client address is the connection's own address unless that peer is listed
# here; then X-Forwarded-For is read right to left and the first address that is
# not listed is the client. It feeds the API token ip_cidr check and the rate limits.
# nginx on the same host as the API (Forge, with Cloudflare real_ip in front):
#   proxy_set_header X-Forwarded-For $remote_addr;
# and keep the default, which trusts only loopback. Do not list 0.0.0.0/0: that lets
# any caller choose its own address. Behind API Gateway / Lambda the peer is the
# source IP and nothing needs to be trusted.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# -----------------------------------------------------------------------------
# Rate limits (attempts per minute; 0 turns a limit off)
# -----------------------------------------------------------------------------
# Counted in the Cache (Redis) per client IP, see TRUSTED_PROXIES above.
# THROTTLE_LOGIN_PER_IP_EMAIL=10     # POST /v1/auth/login, per IP + email
# THROTTLE_LOGIN_PER_IP=60           # POST /v1/auth/login, per IP
# THROTTLE_RECOVER_PER_IP_EMAIL=5    # POST /v1/auth/recover, per IP + email
# THROTTLE_AUTH_PER_IP=60            # other /v1/auth routes that take a secret, per IP and path
# THROTTLE_API_PER_MINUTE=600        # /api/v1, per API token
