# =============================================================================
# Macro Wallets (WaaS) - Production Environment
# =============================================================================
# NEVER commit this file with real credentials.
# Copy to .env.prod:  cp .env.prod.example .env.prod

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENV=prod
ENVIRONMENT=production
PORT=2002

# -----------------------------------------------------------------------------
# Database (PostgreSQL RDS)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://waas_prod:CHANGE_ME@your-rds-instance.region.rds.amazonaws.com:5432/waas_prod?sslmode=require

# -----------------------------------------------------------------------------
# Redis Cache (ElastiCache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://your-elasticache-endpoint.region.cache.amazonaws.com:6379

# -----------------------------------------------------------------------------
# Blockchain RPC Endpoints (Mainnet — use dedicated provider keys)
# -----------------------------------------------------------------------------
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_PRODUCTION_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BTC_RPC_URL=https://blockstream.info/api

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
API_KEY_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
MASTER_KEY_REF=arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AMZ_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AMZ_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET=waas-deployments-prod

# -----------------------------------------------------------------------------
# SQS Queue URLs (auto-populated by CloudFormation)
# -----------------------------------------------------------------------------
WEBHOOK_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/waas-webhooks-prod
WITHDRAWAL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/waas-withdrawals-prod

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# MAIL_MAILER=log is refused when APP_ENV is production.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
DEBUG=false
GRAPHQL_PLAYGROUND_ENABLED=false

# -----------------------------------------------------------------------------
# Monitoring & Error Reporting
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
MAX_CONNECTIONS=100
IDLE_CONNECTIONS=10
CONNECTION_LIFETIME=3600

# -----------------------------------------------------------------------------
# Client IP behind a reverse proxy
# -----------------------------------------------------------------------------
# Comma-separated CIDRs of the proxies whose X-Forwarded-For the API believes.
# The client address is the connection's own address unless that peer is listed
# here; then X-Forwarded-For is read right to left and the first address that is
# not listed is the client. It feeds the API token ip_cidr check and the rate limits.
# nginx on the same host as the API (Forge, with Cloudflare real_ip in front):
#   proxy_set_header X-Forwarded-For $remote_addr;
# and keep the default, which trusts only loopback. Do not list 0.0.0.0/0: that lets
# any caller choose its own address. Behind API Gateway / Lambda the peer is the
# source IP and nothing needs to be trusted.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# -----------------------------------------------------------------------------
# Rate limits (attempts per minute; 0 turns a limit off)
# -----------------------------------------------------------------------------
# Counted in the Cache (Redis) per client IP, see TRUSTED_PROXIES above.
# THROTTLE_LOGIN_PER_IP_EMAIL=10     # POST /v1/auth/login, per IP + email
# THROTTLE_LOGIN_PER_IP=60           # POST /v1/auth/login, per IP
# THROTTLE_RECOVER_PER_IP_EMAIL=5    # POST /v1/auth/recover, per IP + email
# THROTTLE_AUTH_PER_IP=60            # other /v1/auth routes that take a secret, per IP and path
# THROTTLE_API_PER_MINUTE=600        # /api/v1, per API token
